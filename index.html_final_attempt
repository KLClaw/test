<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NRIC/FIN Validator</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f4f7f6;
        }
        .card {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 400px;
        }
        h2 { margin-top: 0; color: #333; text-align: center; }
        p { color: #666; font-size: 0.9rem; text-align: center; }
        input {
            width: 100%;
            padding: 14px;
            margin: 1rem 0;
            border: 2px solid #eee;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 1.3rem;
            text-transform: uppercase;
            transition: border-color 0.3s;
        }
        input:focus {
            outline: none;
            border-color: #007bff;
        }
        button {
            width: 100%;
            padding: 14px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }
        button:hover { background-color: #0056b3; }
        #result {
            margin-top: 1.5rem;
            padding: 1rem;
            border-radius: 8px;
            display: none;
            font-weight: bold;
            text-align: center;
            line-height: 1.4;
        }
        .valid { background-format: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .invalid { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
    </style>
</head>
<body>

<div class="card">
    <h2>NRIC/FIN Validator</h2>
    <p>Enter Singapore NRIC or FIN number</p>
    <input type="text" id="nricInput" placeholder="e.g. S1234567D" maxlength="9" autocomplete="off">
    <button onclick="validate()">Verify Identity</button>
    <div id="result"></div>
</div>

<script>
function validate() {
    const input = document.getElementById('nricInput').value.toUpperCase().trim();
    const resultDiv = document.getElementById('result');
    
    // 1. Basic Format Validation (S, T, F, G, I, Z)
    if (!/^[STFGIZ]\d{7}[A-Z]$/.test(input)) {
        showResult(false, "Invalid Format!<br><small>Must be S, T, F, G, I, or Z + 7 digits + Letter</small>");
        return;
    }

    const prefix = input[0];
    const digits = input.substring(1, 8).split('').map(Number);
    const checksumChar = input[8];

    // 2. Calculate Weighted Sum
    const weights = [2, 7, 6, 5, 4, 3, 2];
    let sum = 0;
    for (let i = 0; i < 7; i++) {
        sum += digits[i] * weights[i];
    }

    // 3. Determine the correct lookup table based on prefix
    const ST_LOOKUP = ['J', 'Z', 'I', 'H', 'G', 'F', 'E', 'D', 'C', 'B', 'A'];
    const FG_LOOKUP = ['X', 'W', 'U', 'T', 'R', 'Q', 'P', 'N', 'M', 'L', 'K'];

    let remainder = sum % 11;
    let expectedChar = '';

    if (prefix === 'S' || prefix === 'T') {
        expectedChar = ST_LOOKUP[remainder];
    } else {
        // For F, G, I, Z series
        expectedChar = FG_LOOKUP[remainder];
    }

    // 4. Final Verification
    if (checksumChar === expectedChar) {
        showResult(true, "✓ Valid NRIC/FIN!");
    } else {
        showint(false, `✕ Invalid Checksum.<br><small>Expected ${expectedChar}, but got ${checksumChar}</small>`);
    }
}

function showResult(isValid, message) {
    const resultDiv = document.getElementById('result');
    resultDiv.innerHTML = message;
    resultDiv.style.display = 'block';
    resultDiv.className = isValid ? 'valid' : 'invalid';
}

// Added helper to fix the typo in my logic above (showint -> showResult)
